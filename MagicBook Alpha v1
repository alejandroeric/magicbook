<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MagicBook</title>

<style>

body{
margin:0;
font-family:Arial,sans-serif;
background:#FFF9F3;
color:#2D2A32;
}

.screen{
min-height:100vh;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
padding:30px;
text-align:center;
}

.hidden{
display:none;
}

h1{
color:#8B6DF3;
font-size:48px;
margin-bottom:10px;
}

h2{
max-width:600px;
}

button{
background:#8B6DF3;
color:white;
border:none;
padding:15px 30px;
border-radius:12px;
font-size:18px;
cursor:pointer;
margin-top:20px;
}

input,
textarea,
select{
width:320px;
padding:12px;
margin:10px 0;
border-radius:10px;
border:1px solid #ccc;
}

.card{
background:white;
width:320px;
padding:20px;
margin:10px;
border-radius:15px;
box-shadow:0 2px 8px rgba(0,0,0,.1);
}

</style>
</head>

<body>

<!-- HOME -->

<div id="home" class="screen">

<h1>✨ MagicBook</h1>

<h2>
Cada niño merece ser el héroe de su propia historia
</h2>

<button onclick="mostrar('hero')">
Crear una aventura
</button>

</div>

<!-- HERO -->

<div id="hero" class="screen hidden">

<h1>✨ Crear Héroe</h1>

<input type="text" placeholder="Nombre">

<input type="number" placeholder="Edad">

<textarea placeholder="¿Qué le gusta?"></textarea>

<textarea placeholder="¿Qué lo hace especial?"></textarea>

<button onclick="mostrar('story')">
Continuar
</button>

</div>

<!-- STORY -->

<div id="story" class="screen hidden">

<h1>📚 Crear Historia</h1>

<select>
<option>Fantasía</option>
<option>Ciencia Ficción</option>
<option>Popular</option>
<option>Literario</option>
<option>Misterio</option>
<option>Realista</option>
<option>Terror Infantil</option>
</select>

<input type="text" placeholder="Mundo">

<textarea placeholder="Contanos tu idea"></textarea>

<button onclick="mostrar('generando')">
Generar aventura
</button>

</div>

<!-- GENERANDO -->

<div id="generando" class="screen hidden">

<h1>✨ Generando...</h1>

<p>✅ Character Bible</p>

<p>✅ Story Bible</p>

<p>✅ Universo</p>

<p>⏳ Libro</p>

<button onclick="mostrar('reader')">
Ver Libro
</button>

</div>

<!-- READER -->

<div id="reader" class="screen hidden">

<h1>📖 Sofía y el Dragón Azul</h1>

<div class="card">

<h3>Página 1</h3>

<p>
Sofía observaba las estrellas desde su ventana
cuando una luz azul apareció entre los árboles.
</p>

</div>

<button onclick="mostrar('library')">
Ir a Biblioteca
</button>

</div>

<!-- LIBRARY -->

<div id="library" class="screen hidden">

<h1>📚 Biblioteca MagicBook</h1>

<div class="card">
📖 Sofía y el Dragón Azul
</div>

<div class="card">
📖 Sofía en Marte
</div>

<div class="card">
📖 Luna y el Reino de Cristal
</div>

<button onclick="mostrar('home')">
Volver al inicio
</button>

</div>

<script>

function mostrar(id){

document.querySelectorAll('.screen')
.forEach(x => x.classList.add('hidden'));

document.getElementById(id)
.classList.remove('hidden');

}

</script>

</body>
</html>
